{
  "name": "hippie-turismo-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "start:dev": "node --env-file=.env.development src/server.js",
    "dev": "node --watch --env-file=.env.development src/server.js",
    "start:test": "node --env-file=.env.test src/server.js",
    "start:prod": "node --env-file=.env.production src/server.js",
    "test": "node --env-file=.env.test --test test/*.test.js",
    "env:check": "node ../tools/check-environments.mjs",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "admin": "node --env-file-if-exists=.env scripts/admin.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "migrate:prod": "node --env-file=.env.production scripts/migrate.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "firebase-admin": "^13.5.0",
    "geofire-common": "^6.0.0",
    "helmet": "^8.1.0",
    "zod": "^4.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
