# demo: dados fictícios em memória; firebase: dados persistidos no Firestore.
DATA_MODE=demo
PORT=3000
HOST=127.0.0.1
# Firebase: definir DATA_MODE=firebase e as credenciais fora da pasta do projeto.
# GOOGLE_APPLICATION_CREDENTIALS=C:/segredos/service-account.json
# GOOGLE_CLOUD_PROJECT=seu-projeto
# Opcional: Places API (New), chave restrita ao servidor e à API.
# GOOGLE_PLACES_API_KEY=

# Antes do primeiro start em Firebase, execute: npm run migrate
